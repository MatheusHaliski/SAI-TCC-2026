@startuml RF5_Criar_Look_Corrigido

!define FIRESTORE_COLOR #E8F5E9
!define MYSQL_COLOR #E3F2FD
!define REDIS_COLOR #FFF3E0
!define ENUM_COLOR #F3E5F5

title RF5 — Criar Esquema de Vestimenta (Look): Diagrama de Classes Atualizado

'' ===== ENUMERAÇÕES =====

enum SlotType #ENUM_COLOR {
  TOP
  BOTTOM
  SHOES
  ACCESSORIES
}

enum StyleType #ENUM_COLOR {
  classic
  minimalist
  modern
  chic
  streetwear
  sporty
  athleisure
  preppy
  romantic
  boho
  vintage
  grunge
  edgy
  glam
  luxury
  avant_garde
  y2k
  utility
  techwear
  tailored
  urban
  resort
  basic
  statement
  futuristic
}

enum OccasionType #ENUM_COLOR {
  casual
  work
  business
  formal
  party
  night_out
  date
  wedding
  ceremony
  sport
  gym
  travel
  beach
  vacation
  school
  university
  social
  home
  outdoor
  festival
}

enum CreationMode {
  MANUAL
  AI_ASSISTED
}

enum SchemeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum Visibility {
  PRIVATE
  FOLLOWERS
  PUBLIC
}

enum RenderingStatus {
  PENDING
  RENDERING
  ENHANCING
  COMPOSITING
  COMPLETED
  FAILED
}

enum SealType #ENUM_COLOR {
  premium
  eco_friendly
  trending
  limited_edition
  exclusive
  budget_friendly
  luxury
  casual_chic
  affordable_chic
  premium_look
  eco_conscious
  trendy_combo
  casual_elegance
  professional
  activewear
}

'' ===== ENTIDADES =====

entity User {
  * id: UUID [PK]
  * email: String [UNIQUE]
  * fullName: String
  * createdAt: Timestamp
  * updatedAt: Timestamp
}

entity WardrobeItem <<FirestoreDocument>> {
  * id: UUID [PK]
  * name: String
  * category: String
  * createdAt: Timestamp
}

entity Scheme <<FirestoreDocument>> #FIRESTORE_COLOR {
  * id: UUID [PK]
  * userId: UUID [FK → User]
  --
  ** CAMPOS DO FORMULÁRIO **
  * title: String
  * description: String [OPTIONAL]
  * visibility: Visibility
  * status: SchemeStatus
  --
  ** CONTEXTUALIZAÇÃO (Taxonomias Controladas) **
  * occasion: OccasionType[] (≤3, sintetizado)
  * style: StyleType[] (≤3, sintetizado)
  * season: String [OPTIONAL]
  * mood: String [OPTIONAL]
  --
  ** PREÇO E SELOS **
  * totalPrice: Float (derivado - soma de peças, USD)
  * seals: SealType[] (≤4, sugerido pela IA)
  --
  ** COMPOSIÇÃO VISUAL **
  * backgroundColor: String
  * backgroundGradient: String [OPTIONAL]
  * backgroundImageUrl: URL [OPTIONAL - RF11]
  * displayMode: String (CAROUSEL|GRID|STACKED)
  --
  ** RF18 - RENDERIZAÇÃO 2D **
  * renderingStatus: RenderingStatus
  * virtualTryOnUrl: URL [OPTIONAL]
  * renderingJobId: UUID [FK → OutfitRenderJob, OPTIONAL]
  * renderingQuality: JSON [OPTIONAL]
  * cachedUntil: Timestamp [OPTIONAL]
  * renderingMetadata: JSON [OPTIONAL]
  --
  ** ENGAJAMENTO & MONITORAMENTO **
  * likes: Integer
  * shares: Integer
  * remixes: Integer
  * view_count: Integer
  * save_count: Integer
  * tags: String[]
  * is_remixed_from: UUID [FK → Scheme, OPTIONAL]
  --
  ** GERAÇÃO COM IA **
  * creationMode: CreationMode
  --
  * createdAt: Timestamp
  * updatedAt: Timestamp
  * publishedAt: Timestamp [DERIVADO]
}

entity SchemeItem <<FirestoreDocument>> #FIRESTORE_COLOR {
  * id: UUID [PK]
  * schemeId: UUID [FK → Scheme]
  * wardrobeItemId: UUID [FK → WardrobeItem]
  --
  ** POSICIONAMENTO VISUAL **
  * slot: SlotType
  * zIndex: Integer (0-1000)
  * sortOrder: Integer
  * positionX: Float (0-100%)
  * positionY: Float (0-100%)
  * scale: Float (0.5-2.0)
  * rotation: Float (0-360°)
  * opacity: Float (0-1)
  --
  ** EFEITOS **
  * filters: JSON {
      blur: Float (0-100)
      saturation: Float (-100 to 100)
      brightness: Float (-100 to 100)
      contrast: Float (-100 to 100)
      hue_shift: Float (0-360)
    }
  --
  ** ESTADO **
  * visibility: Enum (VISIBLE|HIDDEN)
  * createdAt: Timestamp
  * updatedAt: Timestamp
}

entity SchemeBackground <<FirestoreDocument>> #FIRESTORE_COLOR {
  * id: UUID [PK]
  * schemeId: UUID [FK → Scheme]
  * backgroundColor: String
  * backgroundGradient: String [OPTIONAL]
  * backgroundImageUrl: URL [OPTIONAL]
  * colorStartHex: String [OPTIONAL]
  * colorEndHex: String [OPTIONAL]
  * gradientAngle: Integer [OPTIONAL]
  * displayMode: String
  * opacity: Float
  * blurBackground: Float [OPTIONAL]
  * patternOverlay: String [OPTIONAL]
  * createdAt: Timestamp
  * updatedAt: Timestamp
}

entity AIAssistance <<FirestoreDocument>> #FIRESTORE_COLOR {
  * id: UUID [PK]
  * schemeId: UUID [FK → Scheme]
  * userDescription: String
  * occasion: OccasionType[] [FROM peças]
  * mood: String [OPTIONAL]
  * style_preferences: StyleType[] [FROM peças]
  * suggestedItems: SchemeItem[]
  * confidenceScores: Float[]
  * generationAttempts: Integer
  * createdAt: Timestamp
}

entity OutfitRenderJob <<FirestoreDocument>> #FIRESTORE_COLOR {
  * id: UUID [PK]
  * schemeId: UUID [FK]
  * renderingStatus: RenderingStatus
  * renderingType: String (Fashn.ai|Custom)
  * total_processing_time_ms: Integer
  * stage_times: JSON
  * final_quality_score: Float
  * quality_metrics: JSON
  * createdAt: Timestamp
  * completed_at: Timestamp
}

entity RenderCache <<Redis>> #REDIS_COLOR {
  * schemeId: UUID [PK]
  * renderType: String
  * renderUrl: URL
  * thumbnailUrl: URL
  * quality: Float
  * generatedAt: Timestamp
  * accessCount: Integer
  * lastAccessed: Timestamp
  * ttl: Integer (3600s)
}

entity RenderJobsLog <<MySQL>> #MYSQL_COLOR {
  * id: UUID [PK]
  * scheme_id: UUID [FK]
  * user_id: UUID [FK]
  * rendering_type: String
  * status: String
  * total_processing_time_ms: Integer
  * stage_times: JSON
  * final_quality_score: Float
  * total_cost: Float
  * retry_count: Integer
  * created_at: Timestamp
  * completed_at: Timestamp
}

entity Brand <<MySQL>> #MYSQL_COLOR {
  * id: UUID [PK]
  * name: String
  * createdAt: Timestamp
}

entity SchemeLike <<MySQL>> #MYSQL_COLOR {
  * id: UUID [PK]
  * schemeId: UUID [FK]
  * userId: UUID [FK]
  * createdAt: Timestamp
}

entity SchemeComment <<MySQL>> #MYSQL_COLOR {
  * id: UUID [PK]
  * schemeId: UUID [FK]
  * userId: UUID [FK]
  * text: String
  * createdAt: Timestamp
}

entity SchemeRemix <<MySQL>> #MYSQL_COLOR {
  * id: UUID [PK]
  * originSchemeId: UUID [FK]
  * remixSchemeId: UUID [FK]
  * createdAt: Timestamp
}

'' ===== RELACIONAMENTOS =====

User "1" -- "0..*" Scheme : creates
Scheme "1" -- "1..*" SchemeItem : contains
Scheme "1" -- "0..1" SchemeBackground : has
Scheme "1" -- "0..1" AIAssistance : generates_via
Scheme "0..*" -- "0..*" StyleType : has_styles (≤3, sintetizado)
Scheme "0..*" -- "0..*" OccasionType : has_occasions (≤3, sintetizado)
Scheme "0..*" -- "0..*" SealType : has_seals (≤4, sugerido)

SchemeItem "0..*" -- "1" WardrobeItem : references
SchemeItem "0..*" -- "1" SlotType : uses_slot

Scheme "1" -- "0..*" OutfitRenderJob : uses
Scheme "1" -- "0..1" RenderCache : cached_in
Scheme "1" -- "0..*" RenderJobsLog : audited_by

Scheme "1" -- "0..*" SchemeLike : receives
Scheme "1" -- "0..*" SchemeComment : receives
Scheme "1" -- "0..*" SchemeRemix : remixed_from

'' ===== NOTAS =====

note right of Scheme
  **Armazenamento Principal:** Firestore (/users/{userId}/schemes)
  **5-ÉTAPAS DE CRIAÇÃO:**
  1. Escolher modo (MANUAL ou AI_ASSISTED)
  2. Preencher prompt IA (acumula em aiAssistance)
  3. Preencher formulário manual (acumula em items)
  4. Editar fundo (RF11 - backgroundImageUrl)
  5. Preview + Salvar (RF18 - renderização)

  **CRITICAL:** Etapas 2 e 3 NÃO são excludentes
  Resultados se acumulam até salvar (nada persiste antes)

  **Style & Occasion:**
  - IA deve SINTETIZAR (não concatenar) tags das peças
  - Descrição do efeito visual do conjunto completo
  - Máximo 3 valores cada (vs. 2 para peça)

  **Preço & Selos:**
  - totalPrice: derivado (soma dos preços das peças)
  - seals: máximo 4, sugeridos automaticamente pela IA
    ao selecionar peças (baseado na combinação)
end note

note right of SchemeItem
  **Armazenamento:** Firestore (subcoleção items)
  **Slot:** 4 valores apenas
  - TOP (parte cima) ↔ categoria PARTE_CIMA
  - BOTTOM (parte baixo) ↔ categoria PARTE_BAIXO
  - SHOES (tênis) ↔ categoria TENIS
  - ACCESSORIES (acessório) ↔ categoria ACESSORIO

  **Posicionamento:** Canvas 2D no provador virtual
  **Múltiplos Efeitos:** Blur, saturação, brilho, contraste, matiz
end note

note right of AIAssistance
  **Geração com IA (RF24):**
  Analisa peças inseridas e sugere combinações
  Retorna até 3 SchemeItem com confidenceScores
  Acumula até etapa 5 (salvar)

  **Regra IA:** Valores de style/occasion ranqueados,
  não simples concatenação de tags das peças
end note

note right of OutfitRenderJob
  **RF18 - Provador Virtual 2D:**
  Pipeline: Fashn.ai → Cleanup.ai → Canvas 2D
  Status: PENDING → RENDERING → ENHANCING → COMPOSITING → COMPLETED/FAILED
  Qualidade: overall_score (0-1), colors_matched, fabric_realism, composition_score
  Cache: TTL 1 hora em Redis
end note

note right of StyleType
  **Taxonomia Compartilhada:** RF4 (≤2) e RF5 (≤3)
  **25 Estilos Predefinidos (ID do banco de dados)**
  Clássico, Minimalista, Moderno, Chique, Streetwear,
  Esportivo, Athleisure, Colegial, Romântico, Boêmio,
  Vintage, Grunge, Ousado, Glamouroso, Luxuoso,
  Vanguarda, Anos2000, Utilitário, Techwear, Alfaiataria,
  Urbano, Resort, Básico, Marcante, Futurista
end note

note right of OccasionType
  **Taxonomia Compartilhada:** RF4 (≤2) e RF5 (≤3)
  **20 Ocasiões Predefinidas (ID do banco de dados)**
  Casual, Trabalho, Negócios, Formal, Festa,
  Saída Noturna, Encontro, Casamento, Cerimônia, Esporte,
  Academia, Viagem, Praia, Férias, Escola,
  Universidade, Evento Social, Casa, Atividade Ar Livre, Festival
end note

note right of SealType
  **Selos/Badges Sugeridos pela IA (RF5):**
  Sistema analisa a combinação de peças selecionadas
  e sugere automaticamente até 4 selos para o esquema
  **Máximo:** 4 selos por esquema de vestimenta
  **Exemplos:** Affordable-chic, Premium-look, Eco-conscious,
  Trendy-combo, Casual-elegance, Professional, Activewear, etc.
end note

@enduml
