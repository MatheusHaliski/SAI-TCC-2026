@startuml RF12-Cronologia-Estilo
!define ACCENT #8B5CF6
!define SECONDARY #EC4899
!define SUCCESS #10B981
!define WARNING #F59E0B

title RF12 — Visualizar e Editar "Minhas Fotos"\nCronologia de Estilo Interativa

start

:👤 Usuário autenticado
acessa "Minhas Fotos"/;

:🔄 Sistema carrega
acervo de fotos
(peça, esquema, DNA, provador)/;

:📊 IA detecta padrões
- cores preferidas
- tipos de peça
- ocasiões recorrentes
- peças "momento-chave"/;

:💡 Sistema exibe card de insights
"Você subiu 40% o uso de roxo
nos últimos 2 meses"/;

:🎯 Usuário escolhe
modo de visualização/;

if (modo = TIMELINE?) then (✅ Sim)
  :📅 Sistema agrupa fotos
  por período (semana/mês)

  Cada grupo mostra:
  - 2-4 fotos representativas
  - Contador "X fotos neste período"
  - Contexto: ocasião, estilo, engajamento/;

  :⭐ Identifica momentos-chave
  - Fotos com ≥200 curtidas (RF19)
  - Peças usadas em ≥10 looks
  - DNA de Estilo

  Marca com destaque visual/;

  :🏷️ Enriquece contexto
  Cada foto exibe:
  - Origem (peça/esquema/DNA/provador)
  - Ocasião, estilo, material
  - Engajamento social (curtidas, comentários)
  - "Por quê foi criada"/;

else (❌ Não - Grade)
  :🖼️ Sistema exibe
  grade de imagens (thumbnail)

  Cada card mostra:
  - Imagem em destaque
  - Badge de origem
  - Engajamento social/;

endif

:🔍 Usuário aplica filtros
avançados (opcional)/;

if (quer filtrar?) then (✅ Sim)

  if (escolhe ORIGEM?) then (✅ Peça/Esquema/DNA)
    :Filter por origem selecionada/;
  else
    :Mantém todas as origens/;
  endif

  if (escolhe PERÍODO?) then (✅ Últimas 4 sem / Mês / 3 meses / Ano)
    :Recalcula agrupamento
    com novo intervalo temporal/;
  else
    :Timeline padrão/;
  endif

  if (escolhe OCASIÃO?) then (✅ Formal/Casual/Esporte)
    :Filtra por ocasião/;
  else
    :Mostra todas as ocasiões/;
  endif

  if (escolhe ESTILO?) then (✅ Minimalista/Maximista/Eclético)
    :Filtra por estilo pessoal/;
  else
    :Mostra todos os estilos/;
  endif

  if (escolhe COR?) then (✅ Cores específicas)
    :IA detecta cores dominantes
    e filtra fotos que contêm
    aquelas cores/;
  else
    :Mostra todas as cores/;
  endif

else (❌ Não)
  :Exibe timeline completa
  sem filtros adicionais/;
endif

:📊 Sistema aplica filtros
e recalcula vista/;

:🎬 Exibe timeline atualizada
com:
- Fotos agrupadas por período
- Momentos-chave destacados (⭐)
- Contexto enriquecido
- Engajamento social visível/;

:👆 Usuário seleciona
uma foto/;

if (quer COMPARAÇÃO?) then (✅ Sim - "Evolução")
  :Compara dois períodos
  lado-a-lado:
  - Paleta de cores
  - Tipos de peça dominantes
  - Ocasiões principais
  - Estilo prevalente/;

else (❌ Não - Ação direta)
  :Segue para ação/;
endif

:🎨 Usuário escolhe ação/;

if (ação = EDITAR?) then (✅ Editar)
  :Abre Editor Canvas 2D (RF15)
  com foto carregada

  Ferramentas:
  - Recorte, rotação
  - Brilho/contraste
  - Remoção de fundo/;

  if (usuário salva?) then (✅ Sim)
    :Imagem editada substitui
    a exibida na peça

    Original preservada em
    "Minhas Fotos"/;
  else
    :Descarta edições
    Original permanece íntegra/;
  endif

else if (ação = DOWNLOAD?) then (✅ Download)
  :Entrega imagem original
  SEM marca d'água

  (disponível apenas
  para o dono da foto)/;

else if (ação = DELETAR?) then (✅ Deletar)

  if (foto vinculada a peça ativa?) then (✅ Sim)
    :⚠️ Sistema avisa:
    "Peça ficará sem imagem"

    Exige confirmação explícita/;

    if (usuário confirma?) then (✅ Sim)
      :Deleta foto/;
    else
      :Cancela operação/;
    endif

  else
    :Deleta imagem diretamente
    com confirmação simples/;
  endif

else if (ação = DELETAR EM LOTE?) then (✅ Múltiplas)

  :Usuário seleciona várias fotos
  com checkboxes/;

  :Sistema pede confirmação única:
  "Deseja deletar X fotos?"/;

  if (usuário confirma?) then (✅ Sim)
    :Deleta todas as fotos
    selecionadas/;
  else
    :Cancela operação/;
  endif

endif

:✅ Ação concluída/;

:🎁 Sistema atualiza timeline
- Recarrega a vista
- Recalcula padrões (se necessário)
- Exibe insights atualizados/;

if (usuário quer explorar mais?) then (✅ Sim)
  :Volta para seleção de foto/;
else (❌ Não)
  :Sai de "Minhas Fotos"/;
endif

stop

note right of start
  **RF12 Critérios de Aceite Implementados:**
  ✅ RF12.CA01 — Acesso e agrupamento por origem
  ✅ RF12.CA02 — Editor Canvas 2D (RF15)
  ✅ RF12.CA03 — Aviso antes deletar vinculada
  ✅ RF12.CA04 — Exclusão em lote
  ✅ RF12.CA05 — Download sem marca d'água
  ✅ RF12.CA06 — Lazy load (>50 fotos)

  **Novos CAs da Cronologia de Estilo:**
  ✅ RF12.CA07 — Agrupamento por período
  ✅ RF12.CA08 — Momentos-chave identificados
  ✅ RF12.CA09 — Contexto enriquecido
  ✅ RF12.CA10 — Filtros temporais
  ✅ RF12.CA11 — Insights de padrão
  ✅ RF12.CA12 — Comparação de períodos
end note

@enduml