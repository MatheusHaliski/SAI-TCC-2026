@startuml RF4_AdicionarPeca_Gateway_IA

title RF4 — Adicionar Peça ao Guarda-Roupa: Gateway de IA (Detecção)

' ============================================================================
' DIAGRAMA DE ATIVIDADES — Fluxo com Gateway de IA para análise de imagem
' ============================================================================

start

:Etapa 1: Usuário Abre 'Adicionar Nova Peça';

:Etapa 2: Upload de Foto(s);
:Usuário envia uma ou mais fotografias;

:Validar Formato e Tamanho;
if (Formato JPG/PNG/WebP e ≤ 10 MB?) then (Sim)
    :Formato OK;
else (Não)
    :❌ Recusar com mensagem clara;
    note right : RF4.CA01 - Motivo: formato, tamanho ou número de arquivos
    :Retornar para upload;
    stop
endif

:Etapa 3: Verificar Quantidade de Fotos;
if (Mais de uma foto?) then (Sim)
    :Criar rascunho por foto (lote);
    note right : RF4.CA05 - Revisão em lote
else (Não)
    :Criar um rascunho único;
endif

:================================;
:**🤖 GATEWAY DE IA (RF24.CA01)**;
:**Detecção de Peça**;
:================================;
:Enviar imagem(ns) para IA;
:IA analisa: categoria, cor dominante, tecido;
:IA retorna índice de confiança;

:**Validação de Confiança**;
if (Confiança suficiente?) then (Sim ≥ threshold)
    :✅ Confiança Alta;
    :Etapa 4: Pré-preencher Formulário;
    :Pré-preencher: categoria, cor dominante, tecido;
    note right : RF4.CA02 - Tudo editável
else (Não < threshold)
    :⚠️ Confiança Baixa;
    :Etapa 4: Formulário Vazio;
    :Exibir aviso de preenchimento manual;
    note right : RF4.CA03 - Sem bloqueio, apenas aviso
endif

:Etapa 5: Revisão e Completamento Manual;
:Usuário revisa e edita os campos;
:Usuário completa: nome, categoria, cor;

:Validar Campos Obrigatórios;
if (Todos obrigatórios preenchidos?) then (Sim)
    :✅ Validação OK;
else (Não)
    :❌ Indicar campos faltantes;
    note right : Mensagem de erro por campo
    :Retornar para edição;
    backward :Retornar à edição;
endif

:Etapa 6: Remoção de Fundo;
:Enviar para serviço de background removal;

:Verificar Disponibilidade do Serviço;
if (Serviço de remoção disponível?) then (Sim)
    :Processar remoção de fundo;
    :Salvar com fundo removido;
else (Não)
    :⚠️ Serviço indisponível;
    :Salvar com foto original;
    :Enfileirar para reprocessamento;
    note right : RF4.CA06 - Sem bloquear o usuário
endif

:Etapa 7: Persistência;
:Persistir peça em ClothingPiece (banco);
:Gerar miniatura e URLs;

:Etapa 8: Aparição no Closet Digital;
:Peça aparece imediatamente;
note right : RF4.CA04 - Sem delay, integrado com RF6

:Etapa 9: Registro de Inferência;
:Registrar metadados da IA;
note right : RF4.CA04, RF24.CA16 - Auditoria

:✅ Peça adicionada com sucesso;

stop

@enduml


@startuml RF4_AdicionarPeca_Diagrama_Sequencia

title RF4 — Adicionar Peça: Diagrama de Sequência (Gateway IA)

actor User
participant "UI (AddPieceView)" as UI
participant "API Routes" as API
participant "Service Layer" as SVC
participant "Database (MySQL)" as DB
participant "IA Vision Service" as IA
participant "Background Removal" as BgRemove

User->>UI: Clica "Adicionar Nova Peça"
UI->>UI: Abre seletor de arquivo

User->>UI: Seleciona foto(s)
UI->>UI: Valida formato JPG/PNG/WebP e tamanho ≤ 10MB
note over UI: CA01 - Validação local

UI->>API: POST /api/wardrobe-items/upload {files: [...]}
API->>SVC: processUpload(files)

alt Múltiplas fotos
    SVC->>DB: Criar rascunho para cada foto
else Foto única
    SVC->>DB: Criar um rascunho
end

SVC->>IA: analyzeImage(image_bytes)
note over IA: CA02/CA03 - Gateway de IA (RF24.CA01)

IA->>IA: Detecta peça, categoria, cor, tecido
IA-->>SVC: {category, color, material, confidence: 0.95}

alt Confiança ≥ threshold (CA02)
    SVC->>DB: Pré-preencher forma com sugestões
    note over DB: CA02 - Editável
    SVC-->>API: prepopulated_form
    API-->>UI: Exibe com valores sugeridos
else Confiança < threshold (CA03)
    SVC->>DB: Criar rascunho vazio
    SVC-->>API: empty_form + warning
    API-->>UI: Aviso: "Preencha manualmente"
end

User->>UI: Revisa/edita campos
UI->>UI: Valida campos obrigatórios

alt Campos válidos
    UI->>API: POST /api/wardrobe-items {category, color, name, ...}
else Faltam campos
    UI->>User: Indicar campos faltantes
    User->>UI: Completar campos
end

API->>SVC: createWardrobeItem(data)
SVC->>DB: Salvar em wardrobe_items (rascunho)

SVC->>BgRemove: removeBackground(image_url)
note over BgRemove: CA06 - Com fallback se indisponível

alt Sucesso
    BgRemove-->>SVC: processed_image_url
    SVC->>DB: update wardrobe_items (imagem processada)
else Falha/Timeout
    note over SVC: Enfileirar reprocessamento (RNF8)
    SVC->>DB: update status = pending_bg_removal
end

SVC->>DB: Salvar registro de inferência IA
note over DB: CA04, RF24.CA16 - Auditoria

SVC-->>API: wardrobe_item_created
API-->>UI: 201 Created

UI->>UI: Redireciona para Closet Digital
User->>UI: Visualiza peça adicionada (CA04)

@enduml


@startuml RF4_AdicionarPeca_Componentes

title RF4 — Adicionar Peça: Diagrama de Componentes

package "Frontend (Next.js)" {
  component "AddPieceView" as View
  component "FileUploadInput" as Upload
  component "FormBuilder" as Form
  component "ImagePreview" as Preview
}

package "Backend (API Routes)" {
  component "PieceController" as PieceCtrl
  component "PieceService" as PieceSvc
  component "IADetectionService" as IAService
  component "ImageProcessingService" as ImgSvc
  component "ValidationEngine" as Validator
}

package "Data Layer" {
  component "WardrobeRepository" as WardrobeRepo
  database "MySQL\n(wardrobe_items, piece_metadata)" as DB
}

package "External Services" {
  component "Google Gemini Vision\n(IA Detecção)" as GeminiVision
  component "rembg / remove.bg\n(Background Removal)" as RemBg
  component "Object Storage\n(Image CDN)" as CDN
}

View --> Upload: Renderiza upload
Upload --> PieceCtrl: POST /upload

PieceCtrl --> Validator: Valida formato/tamanho
Validator --> PieceSvc: Se válido

PieceSvc --> IAService: analyzeImage()
IAService --> GeminiVision: Envia para Gemini Vision
GeminiVision --> IAService: Retorna análise

IAService --> Form: Pré-preenche ou avisa

View --> Form: Renderiza formulário
Form --> PieceCtrl: Submit

PieceCtrl --> PieceSvc: createWardrobeItem()
PieceSvc --> WardrobeRepo: Salvar peça
WardrobeRepo --> DB: INSERT wardrobe_items

PieceSvc --> ImgSvc: removeBackground()
ImgSvc --> RemBg: Processar remoção
RemBg --> CDN: Upload imagem processada
CDN --> DB: Armazenar URL

PieceSvc --> WardrobeRepo: Salvar metadados IA
WardrobeRepo --> DB: INSERT piece_metadata

@enduml


@startuml RF4_AdicionarPeca_Estados

title RF4 — Adicionar Peça: Máquina de Estados

state "Não Iniciado" as NotStarted
state "Upload em Progresso" as Uploading
state "Validação de Arquivo" as FileValidation {
  state "Formato/Tamanho OK" as FormatOK
  state "Formato Inválido" as FormatError
}

state "Rascunho Criado" as DraftCreated

state "IA Detecção" as IADetection {
  state "Enviando para IA" as SendingIA
  state "Analisando Imagem" as AnalyzingIA
  state "Confiança Alta" as HighConfidence
  state "Confiança Baixa" as LowConfidence
}

state "Preenchimento de Formulário" as FormFilling {
  state "Pré-preenchido (CA02)" as Prepopulated
  state "Vazio com Aviso (CA03)" as EmptyForm
  state "Edição Manual" as ManualEdit
}

state "Validação de Campos" as FieldValidation {
  state "Campos OK" as FieldsOK
  state "Campos Faltantes" as MissingFields
}

state "Processamento de Imagem" as ImageProcessing {
  state "Removendo Fundo" as RemovingBg
  state "Sucesso" as BgRemovalSuccess
  state "Fallback (Original)" as BgRemovalFallback
}

state "Persistência" as Persistence {
  state "Salvando Peça" as SavingPiece
  state "Salvando Metadados IA" as SavingMetadata
}

state "Finalização" as Finalization {
  state "Aparecendo no Closet" as InCloset
  state "Enfileirado para Processamento" as Queued
}

NotStarted --> Uploading: Usuário seleciona arquivo

Uploading --> FileValidation: Upload concluído

FileValidation --> FormatOK: Válido
FileValidation --> FormatError: Inválido
FormatError --> [*]: CA01 - Recusa

FormatOK --> DraftCreated: Criar rascunho

DraftCreated --> IADetection: Iniciar detecção

IADetection --> SendingIA: Enviar imagem
SendingIA --> AnalyzingIA: IA processa
AnalyzingIA --> HighConfidence: confidence ≥ threshold
AnalyzingIA --> LowConfidence: confidence < threshold

HighConfidence --> Prepopulated: CA02 - Pré-preenchimento

LowConfidence --> EmptyForm: CA03 - Aviso manual

Prepopulated --> ManualEdit: Usuário revisa
EmptyForm --> ManualEdit: Usuário completa

ManualEdit --> FieldValidation: Usuário confirma

FieldValidation --> FieldsOK: Todos preenchidos
FieldValidation --> MissingFields: Faltam campos
MissingFields --> ManualEdit: Voltar à edição

FieldsOK --> ImageProcessing: Iniciar remoção de fundo

ImageProcessing --> RemovingBg: Serviço disponível?
RemovingBg --> BgRemovalSuccess: Sucesso
RemovingBg --> BgRemovalFallback: Falha/Timeout

BgRemovalSuccess --> Persistence: Avançar
BgRemovalFallback --> Persistence: Com fallback

Persistence --> SavingPiece: Salvar wardrobe_item
SavingPiece --> SavingMetadata: Salvar inferência IA
SavingMetadata --> Finalization: Completado

Finalization --> InCloset: CA04 - Aparecimento imediato
InCloset --> [*]: Peça adicionada

@enduml
