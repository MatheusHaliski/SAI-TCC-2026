# ============================================================
# Scores-p-2026 — Sistema de Pontuações
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# ============================================================

NODE_ENV=development
APP_PORT=3001
APP_URL=

# --- MySQL (novo banco Scores-p-2026) ---
SCORES_DB_HOST=localhost
SCORES_DB_PORT=3306
SCORES_DB_NAME=scores_p_2026
SCORES_DB_USER=scores_app_user
SCORES_DB_PASSWORD=
SCORES_DB_SSL=false

# --- MySQL — usuário de backup ---
SCORES_BACKUP_DB_USER=scores_backup_user
SCORES_BACKUP_DB_PASSWORD=

# --- Sessão e autenticação ---
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=

# --- Backup ---
BACKUP_DIR=./database/backups
