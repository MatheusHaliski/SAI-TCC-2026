# ============================================================
# FAI-TCC-2026 — Fashion AI / StylistAI
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# ============================================================

NODE_ENV=development
APP_PORT=3000
NEXT_PUBLIC_APP_URL=

# --- Firebase (cliente) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=fai_tcc_2026_firestore

# --- Firebase Admin (servidor — NUNCA expor no cliente) ---
NEXT_FIREBASE_ADMIN_PROJECT_ID=
NEXT_FIREBASE_ADMIN_CLIENT_EMAIL=
NEXT_FIREBASE_ADMIN_PRIVATE_KEY=
NEXT_FIREBASE_ADMIN_STORAGE_BUCKET=
NEXT_FIREBASE_DATABASE_ID=

# --- MySQL (novo banco FAI-TCC-2026) ---
FAI_DB_HOST=localhost
FAI_DB_PORT=3306
FAI_DB_NAME=fai_tcc_2026
FAI_DB_USER=fai_app_user
FAI_DB_PASSWORD=
FAI_DB_SSL=false

# --- MySQL — usuário de backup (permissões restritas) ---
FAI_BACKUP_DB_USER=fai_backup_user
FAI_BACKUP_DB_PASSWORD=

# --- Sessão e autenticação ---
SESSION_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
PIN_HASH=
PIN_COOKIE_SECRET=

# --- Google OAuth ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Email ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Storage ---
BLOB_READ_WRITE_TOKEN=

# --- IA e processamento ---
GOOGLE_GEMINI_API_KEY=
MESHY_API_KEY=
FASHN_API_KEY=
REMOVE_BG_API_KEY=

# --- Blender / 3D pipeline ---
BLENDER_CLOUD_API_URL=
BLENDER_CLOUD_API_TOKEN=
GPU_WORKER_TOKEN=
BLENDER_WORKER_TOKEN=

# --- Autopilot ---
NOMINATIM_USER_AGENT=fai-tcc-2026/1.0
WEATHER_CACHE_TTL_SECONDS=1800
AUTOPILOT_MAX_CANDIDATES=50
AUTOPILOT_MIN_WARDROBE_PIECES=3
AUTOPILOT_TOP_N=3
ENABLE_AUTOPILOT=true
ENABLE_WEEK_PLAN=true

# --- Backup ---
BACKUP_DIR=./database/backups
