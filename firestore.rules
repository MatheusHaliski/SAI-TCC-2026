rules_version = '2';
service cloud.firestore {
  match /databases/newsaidb/documents {
    match /saiUsers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /credentials/{credId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /saiBrands/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /saiMarkets/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /saiPieceItems/{docId} { allow read, write: if request.auth != null; }
    match /saiSchemes/{docId} { allow read, write: if request.auth != null; }
    match /saiSchemeItems/{docId} { allow read, write: if request.auth != null; }
    match /saiUserSavedSchemes/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /saiWardrobeItems/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /saiPipelineJobs/{docId} { allow read: if request.auth != null; allow write: if false; }
    match /outfitSelections/{docId} { allow read, write: if request.auth != null; }
    match /saiDailyLooks/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow update: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow delete: if false;
    }
    match /saiOutfitPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /saiWeekPlans/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow update: if false;
      allow delete: if false;
    }
  }
}
