# =============================================================================
# .env.example — SAI / Fashion AI (TCC 2026)
# -----------------------------------------------------------------------------
# Copie para `.env` (`cp .env.example .env`) e preencha com valores REAIS.
# NUNCA versionar `.env`, `.env.local` ou qualquer arquivo com valores reais.
# Em produção (Vercel / CI), usar o gerenciador de secrets da plataforma.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — APENAS Autenticação / Controle de acesso (PROJETO NOVO)
# O Firebase deixou de armazenar dados. Os dados agora ficam no MySQL.
# -----------------------------------------------------------------------------
# Client SDK (públicas — expostas ao browser via NEXT_PUBLIC_*)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Admin SDK (SECRETAS — somente no servidor)
NEXT_FIREBASE_ADMIN_PROJECT_ID=
NEXT_FIREBASE_ADMIN_CLIENT_EMAIL=
# Chave privada: manter os \n escapados em uma única linha.
NEXT_FIREBASE_ADMIN_PRIVATE_KEY=
NEXT_FIREBASE_ADMIN_STORAGE_BUCKET=

# -----------------------------------------------------------------------------
# MySQL — banco de dados principal (substitui o Firestore)
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fai_tcc_2026
# A aplicação NUNCA usa root. Ver projects-migrados/FAI-TCC-2026/SECURITY.md.
MYSQL_USER=fai_app_user
MYSQL_PASSWORD=
# true em produção (conexão TLS/SSL)
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10

# -----------------------------------------------------------------------------
# Redis — contadores, cache, sessão efêmera, rate-limit, filas (Streams)
# Dev: docker-compose.dev.yml. Prod: Upstash / ElastiCache (usar rediss://).
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
# TTL padrão de itens de cache (segundos).
REDIS_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# DynamoDB — feed / timeline dos seguidores (wide-column, fan-out on write)
# Dev: DynamoDB Local (endpoint abaixo). Prod: deixe DYNAMODB_ENDPOINT vazio
# para usar o serviço da AWS e forneça credenciais via IAM/secrets.
# -----------------------------------------------------------------------------
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_PORT=8000
AWS_REGION=us-east-1
# Em dev qualquer valor serve (DynamoDB Local não valida). Em prod: IAM role.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_TABLE_TIMELINE=sai_timeline

# -----------------------------------------------------------------------------
# OpenSearch — busca full-text (peças, usuários, looks públicos)
# Dev: docker-compose.dev.yml (segurança off). Prod: OpenSearch Service (TLS+auth).
# -----------------------------------------------------------------------------
OPENSEARCH_NODE=http://127.0.0.1:9200
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# -----------------------------------------------------------------------------
# Object Storage (S3-compatível) — imagens, PNGs segmentados, GLB / assets 3D
# Dev: MinIO (docker-compose.dev.yml). Prod: Vercel Blob (BLOB_READ_WRITE_TOKEN
# abaixo) OU Amazon S3 com as variáveis S3_*.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=sai-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Somente para o docker-compose de dev (administração local do MySQL).
# A APLICAÇÃO nunca usa root — usa MYSQL_USER/MYSQL_PASSWORD acima.
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_dev_only

# -----------------------------------------------------------------------------
# Segurança da aplicação
# -----------------------------------------------------------------------------
PIN_HASH=
PIN_COOKIE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Serviços externos (tokens secretos — somente no servidor)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
MESHY_API_KEY=
REMOVE_BG_API_KEY=
FASHN_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Pipeline 3D (Blender / GPU workers)
BLENDER_CLOUD_API_URL=
BLENDER_CLOUD_API_TOKEN=
GPU_WORKER_TOKEN=
BLENDER_WORKER_TOKEN=

# -----------------------------------------------------------------------------
# Autopilot de Looks / clima
# -----------------------------------------------------------------------------
NOMINATIM_USER_AGENT="sai-tcc-2026/1.0"
WEATHER_CACHE_TTL_SECONDS=1800
AUTOPILOT_MAX_CANDIDATES=50
AUTOPILOT_MIN_WARDROBE_PIECES=3
AUTOPILOT_TOP_N=3
ENABLE_AUTOPILOT=true
ENABLE_WEEK_PLAN=true

# Análise de peças por IA ("Analisar com Google IA" em Adicionar Peça).
# Sem uma destas chaves o sistema usa dados de demonstração (mock) e o botão
# preenche valores genéricos. Defina GOOGLE_AI_API_KEY para análise real (Gemini).
GOOGLE_AI_API_KEY=
# Opcional. Por padrão o provider Google é ativado quando GOOGLE_AI_API_KEY existe.
# Defina como "false" apenas para desativar explicitamente.
GOOGLE_AI_PROVIDER_ENABLED=
# Modelos Gemini (opcional — valores padrão já são razoáveis).
GOOGLE_AI_MODEL_TEXT=gemini-2.5-pro
GOOGLE_AI_MODEL_VISION=gemini-2.5-pro
# Alternativa: usar OpenAI como provider de análise caso não use Google.
OPENAI_API_KEY=
