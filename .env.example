# Caminho da service account key (mesma chave para source e destination)
SERVICE_ACCOUNT_KEY=./keys/serviceAccount.json

# Banco Firestore de origem
SOURCE_DB=(default)

# Banco Firestore de destino
DEST_DB=newsaidb

# Dry run por variável de ambiente (pode ser sobrescrito por --dry-run)
DRY_RUN=false
NEXT_PUBLIC_FIREBASE_DATABASE_ID=newsaidb

# Autopilot de Looks
NOMINATIM_USER_AGENT="sai-tcc-2026/1.0"
WEATHER_CACHE_TTL_SECONDS=1800
AUTOPILOT_MAX_CANDIDATES=50
AUTOPILOT_MIN_WARDROBE_PIECES=3
AUTOPILOT_TOP_N=3
ENABLE_AUTOPILOT=true
ENABLE_WEEK_PLAN=true

# Análise de peças por IA ("Analisar com Google IA" em Adicionar Peça).
# Sem uma destas chaves o sistema usa dados de demonstração (mock) e o botão
# preenche valores genéricos. Defina GOOGLE_AI_API_KEY para análise real (Gemini).
GOOGLE_AI_API_KEY=
# Opcional. Por padrão o provider Google é ativado quando GOOGLE_AI_API_KEY existe.
# Defina como "false" apenas para desativar explicitamente.
GOOGLE_AI_PROVIDER_ENABLED=
# Modelos Gemini (opcional — valores padrão já são razoáveis).
GOOGLE_AI_MODEL_TEXT=gemini-2.5-pro
GOOGLE_AI_MODEL_VISION=gemini-2.5-pro
# Alternativa: usar OpenAI como provider de análise caso não use Google.
OPENAI_API_KEY=
