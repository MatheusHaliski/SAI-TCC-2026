'' ===== ENTIDADES =====

entity User {
  * id: UUID [PK]
  * email: String [UNIQUE]
  * fullName: String
  * createdAt: Timestamp
  * updatedAt: Timestamp
}

entity WardrobeItem <<FirestoreDocument>> #FIRESTORE_COLOR {
  * id: UUID [PK]
  * userId: UUID [FK → User]
  --
  ** CAMPOS DO FORMULÁRIO **
  * name: String
  * category: ClothingCategory
  * subcategory: String
  * sex: SexType
  * brandId: UUID [FK → Brand, OPTIONAL]
  * color: String
  * material: MaterialType
  * size: String
  * price: Float (USD, obrigatório)
  * seals: SealType[] (≤2, sugerido pela IA)
  * imageUrl: URL
  * imagePath: String
  --
  ** CAMPOS DE DISPONIBILIDADE **
  * availability_status: AvailabilityStatus
  * is_favorite: Boolean
  * for_sale: Boolean
  * condition: ConditionType
  --
  ** CAMPOS RF4 - PROCESSAMENTO **
  * photoProcessingStatus: PhotoProcessingStatus
  * photoQualityScores: Reference [FK → QualityScore]
  * processingJobId: UUID [FK → ProcessingJob]
  * processingTimeMs: Integer
  * flatLayMetadata: JSON
  --
  ** CAMPOS MONITORAMENTO **
  * notes: String
  * tags: String[] (tags pessoais de organização)
  * wear_count: Integer
  * last_worn_date: Timestamp
  * imageMimetype: String
  * imageFileSize: Long
  * imageHash: String
  * thumbnailUrl: URL
  * marketId: UUID [FK → Market, OPTIONAL]
  * purchaseDate: Timestamp [OPTIONAL]
  * purchaseLocation: String [OPTIONAL]
  * sku: String [OPTIONAL]
  * care_instructions: String [OPTIONAL]
  --
  ** CAMPOS DERIVADOS (de Style & Occasion) **
  * style: StyleType[] (≤2, derivado do relacionamento)
  * occasion: OccasionType[] (≤2, derivado do relacionamento)
  --
  * createdAt: Timestamp
  * updatedAt: Timestamp
}

entity QualityScore <<FirestoreDocument>> #FIRESTORE_COLOR {
  * id: UUID [PK]
  * wardrobeItemId: UUID [FK]
  * background_removal_confidence: Float (0-1)
  * perspective_correction_applied: Boolean
  * color_normalization_score: Float (0-1)
  * composition_quality: Float (0-1)
  * failed_stages: String[]
  * retry_count: Integer
  * fallback_used: Boolean
  * createdAt: Timestamp
}

entity ProcessingJob <<FirestoreDocument>> #FIRESTORE_COLOR {
  * id: UUID [PK]
  * wardrobeItemId: UUID [FK]
  * job_type: String
  * status: PhotoProcessingStatus
  * total_processing_time_ms: Integer
  * stage_times: JSON
  * final_quality_score: Float
  * was_accepted: Boolean
  * retry_count: Integer
  * fallback_used: Boolean
  * createdAt: Timestamp
  * completed_at: Timestamp
}

entity Brand <<MySQL>> #MYSQL_COLOR {
  * id: UUID [PK]
  * name: String
  * officialLogoUrl: URL [OPTIONAL]
  * createdAt: Timestamp
}

entity Market <<MySQL>> #MYSQL_COLOR {
  * id: UUID [PK]
  * name: String
  * createdAt: Timestamp
}

entity ProcessingJobsLog <<MySQL>> #MYSQL_COLOR {
  * id: UUID [PK]
  * wardrobe_item_id: UUID [FK]
  * user_id: UUID [FK]
  * job_type: String
  * status: String
  * total_processing_time_ms: Integer
  * stage_times: JSON
  * final_quality_score: Float
  * was_accepted: Boolean
  * retry_count: Integer
  * fallback_used: Boolean
  * created_at: Timestamp
  * completed_at: Timestamp
}

'' ===== RELACIONAMENTOS =====

User "1" -- "0..*" WardrobeItem : owns
WardrobeItem "1" -- "0..*" QualityScore : has
WardrobeItem "1" -- "0..*" ProcessingJob : submits
WardrobeItem "0..*" -- "0..*" StyleType : has_styles (≤2)
WardrobeItem "0..*" -- "0..*" OccasionType : has_occasions (≤2)
WardrobeItem "0..*" -- "0..*" SealType : has_seals (≤2, sugerido)
WardrobeItem "0..1" -- "1" Brand : linkedTo
WardrobeItem "0..1" -- "1" Market : linkedTo
WardrobeItem "1" -- "0..*" ProcessingJobsLog : audited_by

'' ===== NOTAS =====

note right of WardrobeItem
  **Armazenamento:** Firestore (Coleção /users/{userId}/wardrobeItems)
  **Categoria:** 4 valores fixos (PARTE_CIMA, PARTE_BAIXO, TENIS, ACESSORIO)
  **Subcategoria:** Campo String próprio - permite N variações por categoria
    (ex: PARTE_CIMA → camiseta, jaqueta, blazer, etc.)
  **Style & Occasion (Derivados):** Taxonomias Controladas (máx 2 cada)
    - Armazenados via relacionamento N:N com StyleType e OccasionType
    - Sugeridos por IA ou edição manual
    - Distintos de tags[] que são apenas organização pessoal
  **Preço:** Campo obrigatório (USD) - entrada do formulário
  **Selos:** Máximo 2 selos, sugeridos pela IA baseado em:
    - Estilo, ocasião, preço, categoria, material
  **RF4 Pipeline:** Foto → Validação → Rembg (BG) → OpenCV (Perspectiva) →
                   Cloudinary (Cores) → Canvas 2D → Validação Qualidade
end note

note right of QualityScore
  **Armazenamento:** Firestore (Subcoleção ou Documento Relacionado)
  **Propósito:** Rastreamento de qualidade após processamento RF4
  **Score Mínimo:** ≥0.6 para exibir em RF5/RF6
end note

note right of ProcessingJob
  **Armazenamento:** Firestore (/processingJobs coleção global)
  **Auditoria:** Também registra em MySQL (processing_jobs_log)
  **Status:** Transição desde NEW → PROCESSING → COMPLETED/FAILED
  **Fallback:** Se falhar, usa foto original com aviso
end note

note right of StyleType
  **Taxonomia Compartilhada:** RF4 (peça) e RF5 (esquema)
  **25 Estilos Predefinidos:**
  Clássico, Minimalista, Moderno, Chique, Streetwear,
  Esportivo, Athleisure, Colegial, Romântico, Boêmio,
  Vintage, Grunge, Ousado, Glamouroso, Luxuoso,
  Vanguarda, Anos2000, Utilitário, Techwear, Alfaiataria,
  Urbano, Resort, Básico, Marcante, Futurista
end note

note right of OccasionType
  **Taxonomia Compartilhada:** RF4 (peça) e RF5 (esquema)
  **20 Ocasiões Predefinidas:**
  Casual, Trabalho, Negócios, Formal, Festa,
  Saída Noturna, Encontro, Casamento, Cerimônia, Esporte,
  Academia, Viagem, Praia, Férias, Escola,
  Universidade, Evento Social, Casa, Atividade Ar Livre, Festival
end note

note right of SealType
  **Selos/Badges Sugeridos pela IA (RF4):**
  Sistema analisa estilo, ocasião, preço, categoria, material
  e sugere até 2 selos para cada peça
  **Máximo:** 2 selos por peça de roupa
  **Exemplos:** Premium, Eco-friendly, Trending, Limited Edition,
  Exclusive, Budget-friendly, Luxury, Casual-chic, Professional, Activewear
end note

note bottom of WardrobeItem
  **Diferença: Tags vs Style/Occasion:**
  • tags[] = organização pessoal (ex: "favorita", "novo", "venda")
  • style[] & occasion[] = taxonomias controladas (N:N com enums)

  **Campos Derivados:**
  style[] e occasion[] são derivados dos relacionamentos N:N com os enums,
  permitindo acesso direto sem decodificação das relações

  **Subcategorias por Categoria Principal:**
  • PARTE_CIMA (upper_piece) → 18 subcategorias (t_shirt, tank_top, blouse, sweater, hoodie, blazer, cardigan, vest, jacket, coat, dress_shirt, polo_shirt, turtleneck, crop_top, camisole, corset, shrug, poncho)
  • PARTE_BAIXO (lower_piece) → 14 subcategorias (jeans, tailored_pants, casual_pants, chino_pants, cargo_pants, jogger_pants, sweatpants, leggings, shorts, bermuda_shorts, denim_shorts, culottes, skirt, skort)
  • TENIS (shoes_piece) → 18 subcategorias - 6 tênis (casual_sneakers, running_shoes, training_shoes, basketball_shoes, skate_shoes, high_top_sneakers) + outros calçados
  • ACESSORIO (accessory_piece) → 22 subcategorias (handbag, crossbody_bag, tote_bag, clutch, backpack, belt, cap, hat, beanie, scarf, tie, bow_tie, sunglasses, eyeglasses, necklace, bracelet, earrings, ring, watch, gloves, socks, hair_accessory)
end note

@enduml
