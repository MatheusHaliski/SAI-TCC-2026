@startuml RF4_Adicionar_Peca_Corrigido

!define FIRESTORE_COLOR #E8F5E9
!define MYSQL_COLOR #E3F2FD
!define REDIS_COLOR #FFF3E0
!define ENUM_COLOR #F3E5F5

' Configurar bordas adequadas nas entidades
skinparam entity {
  BackgroundColor White
  BorderColor Black
  BorderThickness 2
}

skinparam enum {
  BackgroundColor White
  BorderColor Black
